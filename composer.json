    "homepage": "https://hazelchat.co/integrations/october-cms/",
    "license": "MIT",
    "authors": [
        { "name": "Hazelchat", "email": "hello@hazelchat.co", "homepage": "https://hazelchat.co" }
    ],
    "support": {
        "email": "hello@hazelchat.co",
        "issues": "https://github.com/hazelchat-co/oc-hazelchat-plugin/issues",
        "docs": "https://hazelchat.co/integrations/october-cms/"
    },
    "require": {
        "php": ">=8.0",
        "composer/installers": "~1.0 || ~2.0",
